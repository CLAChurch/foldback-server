[Unit]
Description=Campus Foldback local setup instructions
After=foldback.service
Conflicts=getty@tty1.service
ConditionPathExists=!/run/live/medium

[Service]
ExecStart=/usr/local/bin/foldback-console
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
