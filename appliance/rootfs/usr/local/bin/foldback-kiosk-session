#!/usr/bin/python3
import json, os, subprocess
from pathlib import Path

def run(*args):
    return subprocess.run(args, check=False, text=True, capture_output=True)

run('xset', 's', 'off')
run('xset', '-dpms')
run('xset', 's', 'noblank')
outputs = [{'name': line.split()[0], 'connected': line.split()[1] == 'connected'}
           for line in run('xrandr', '--query').stdout.splitlines()
           if len(line.split()) > 1 and line.split()[1] in ('connected', 'disconnected')]
Path('/run/foldback-display').mkdir(mode=0o755, exist_ok=True)
Path('/run/foldback-display/outputs.json.tmp').write_text(json.dumps(outputs))
os.chmod('/run/foldback-display/outputs.json.tmp', 0o644)
os.replace('/run/foldback-display/outputs.json.tmp', '/run/foldback-display/outputs.json')
try:
    connector = json.loads(Path('/var/lib/foldback/state.json').read_text()).get('settings', {}).get('connector', 'auto')
    connected = [line.split()[0] for line in run('xrandr', '--query').stdout.splitlines() if ' connected' in line]
    if connector in connected:
        run('xrandr', '--output', connector, '--auto', '--primary')
        for other in connected:
            if other != connector:
                run('xrandr', '--output', other, '--off')
except (OSError, ValueError):
    pass
run('xhost', '+SI:localuser:foldback-display')
env = {**os.environ, 'HOME': '/var/lib/foldback-display', 'DISPLAY': ':0'}
subprocess.Popen(['runuser', '-u', 'foldback-display', '--', 'openbox'], env=env)
subprocess.Popen(['unclutter', '--timeout', '0.1'])
os.execvpe('runuser', ['runuser', '-u', 'foldback-display', '--', 'chromium',
    '--kiosk', '--no-first-run', '--no-default-browser-check', '--disable-session-crashed-bubble',
    '--disable-pinch', '--password-store=basic', '--user-data-dir=/var/lib/foldback-display/chromium',
    'http://127.0.0.1:3211/display'], env)
