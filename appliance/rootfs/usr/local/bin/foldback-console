#!/usr/bin/python3
import json, socket, subprocess, time, urllib.request

while True:
    print('\033[2J\033[HCAMPUS FOLDBACK\n', flush=True)
    name = socket.gethostname().split('.')[0]
    print(f'Control panel: https://{name}.local:3210/admin')
    print(f'Trust certificate: https://{name}.local:3210/ca.crt')
    print(subprocess.run(['hostname', '-I'], capture_output=True, text=True).stdout.strip())
    try:
        code = json.load(urllib.request.urlopen('http://127.0.0.1:3211/api/pairing', timeout=2)).get('code')
        print(f'First-setup pairing code: {code}' if code else 'Campus password has been configured.')
    except Exception:
        print('Waiting for the server to start...')
    print('\nFor Wi-Fi: Ctrl+Alt+F2, log in as campus-admin, then run: sudo nmtui')
    print('Return here with Ctrl+Alt+F1; direct TV output uses Ctrl+Alt+F7.')
    print('Install this server’s CA certificate on producer devices for trusted HTTPS.')
    subprocess.run(['openssl', 'x509', '-in', '/etc/foldback/tls/ca.crt', '-noout', '-fingerprint', '-sha256'])
    time.sleep(10)
